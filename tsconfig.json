{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "src/game/**/*.ts",
    "src/game/**/*.js",
    "src/sync/**/*.ts",
    "src/sync/**/*.js",
    "src/push/**/*.js",
    "src/push/**/*.ts",
    "worker/api.js",
    "worker/jsonbin.js",
    "worker/cryptoCodes.js",
    "worker/secureCompare.js",
    "worker/index.js",
    "worker/rooms/**/*.js",
    "worker/rooms/**/*.ts",
    "worker/milty/**/*.js",
    "worker/milty/**/*.ts",
    "worker/stats/**/*.js",
    "worker/stats/**/*.ts",
    "worker/push/**/*.js",
    "worker/push/**/*.ts",
    "worker/rateLimit/**/*.js",
    "worker/rateLimit/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.js",
    "**/*.test.ts"
  ]
}
