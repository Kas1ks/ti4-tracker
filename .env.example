# Optional: set to false to hide cloud buttons in the UI.
# VITE_CLOUD_ENABLED=false

# Server-only secrets for local Vite middleware (`npm run dev`) and Cloudflare Worker.
# Copy to `.env.local` and/or `.dev.vars` — never commit real values.
# Do NOT prefix these with VITE_ (that would leak them into the client build).
JSONBIN_BIN_ID=
JSONBIN_MASTER_KEY=
ADMIN_PIN=
# Required to create live rooms; join-by-code stays public without this.
ROOM_CREATE_SECRET=

# Web Push (optional). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional: same values in cloud.local.json:
# { "binId": "...", "masterKey": "...", "adminPin": "...", "roomCreateSecret": "...",
#   "vapidPublicKey": "...", "vapidPrivateKey": "...", "vapidSubject": "mailto:..." }
