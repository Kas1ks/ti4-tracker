# Client flag only — enables cloud UI. Does NOT embed secrets in the browser bundle.
VITE_CLOUD_ENABLED=true

# Server-only secrets for local Vite middleware (`npm run dev`) and Cloudflare Worker.
# Copy to `.env.local` and/or `.dev.vars` — never commit real values.
# Do NOT prefix these with VITE_ (that would leak them into the client build).
JSONBIN_BIN_ID=
JSONBIN_MASTER_KEY=
ADMIN_PIN=

# Optional: same values in cloud.local.json:
# { "binId": "...", "masterKey": "...", "adminPin": "..." }
